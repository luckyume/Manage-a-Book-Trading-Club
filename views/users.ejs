<%- include('partials/header') %>

<section class="page-head">
  <div>
    <h1>Members</h1>
    <p class="lede">Everyone with a shelf in the club.</p>
  </div>
</section>

<ul class="member-grid">
  <% users.forEach(function (user) { %>
    <li class="member-card">
      <div class="avatar" aria-hidden="true"><%= user.username.slice(0, 1).toUpperCase() %></div>
      <div>
        <h2><a href="/users/<%= user.id %>"><%= user.fullName || user.username %></a></h2>
        <p class="handle">@<%= user.username %></p>
        <p class="place"><%= locationOf(user) || 'location not set' %></p>
        <p class="hint"><%= user.bookCount %> book<%= user.bookCount === 1 ? '' : 's' %> on the shelf</p>
      </div>
    </li>
  <% }) %>
</ul>

<%- include('partials/footer') %>
